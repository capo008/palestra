@page
@model CreateModel
@{
    ViewData["Title"] = "Nuova sala";
}

<h1 class="h3 mb-3">Nuova sala</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Nome" class="form-label"></label>
        <input asp-for="Input.Nome" class="form-control" />
        <span asp-validation-for="Input.Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Capienza" class="form-label"></label>
        <input asp-for="Input.Capienza" class="form-control" type="number" min="1" />
        <span asp-validation-for="Input.Capienza" class="text-danger"></span>
    </div>
            <button type="submit" class="btn btn-primary">Salva</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
